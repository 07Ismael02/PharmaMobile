CREATE TABLE producto (
    id          INTEGER NOT NULL PRIMARY KEY,
    nombre      TEXT    NOT NULL,
    precio      REAL    NOT NULL,
    stock       INTEGER NOT NULL,
    activo      INTEGER NOT NULL DEFAULT 1,
    categoriaId INTEGER,
    pendiente   INTEGER NOT NULL DEFAULT 0,
    intentoEnvio INTEGER NOT NULL DEFAULT 1,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1;

listarPendientesPorEnviar:
SELECT * FROM producto WHERE pendiente = 1 AND intentoEnvio = 0 AND intentos < 5 ORDER BY id DESC;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentoEnvio = 0 AND intentos < 5;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND (intentoEnvio = 1 OR intentos >= 5);

intentosDe:
SELECT intentos FROM producto WHERE id = ?;

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = ? WHERE id = ? AND pendiente = 1 AND intentoEnvio = 0 AND intentos < 5;

marcarFallida:
UPDATE producto SET intentos = 5, ultimoError = ? WHERE id = ? AND pendiente = 1 AND intentoEnvio = 0;

anotarErrorEnvio:
UPDATE producto SET ultimoError = ? WHERE id = ? AND pendiente = 1 AND intentoEnvio = 1;

buscarPorId:
SELECT * FROM producto WHERE id = ?;

insertar:
INSERT OR REPLACE INTO producto
    (id, nombre, precio, stock, activo, categoriaId, pendiente, intentoEnvio)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

marcarIntentoEnvio:
UPDATE producto SET intentoEnvio = 1 WHERE id = ? AND pendiente = 1 AND intentoEnvio = 0;

-- Solo tras un rechazo HTTP definitivo (401/403): el servidor no creó el producto.
revertirIntentoEnvio:
UPDATE producto SET intentoEnvio = 0 WHERE id = ? AND pendiente = 1 AND intentoEnvio = 1;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

borrarPendiente:
DELETE FROM producto WHERE id = ? AND pendiente = 1;

marcarInactivo:
UPDATE producto SET activo = 0 WHERE id = ? AND pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) - 1 FROM producto WHERE id < 0;
